{
  "project": {
    "workflow": {
      "max_rounds": 1,
      "max_concurrency": 1
    },
    "runtime_debug": {
      "max_model_calls": 80,
      "max_physical_provider_requests": 48
    },
    "processing": {
      "llm_model": "local-qwen2.5-7b"
    }
  },
  "researcher": {
