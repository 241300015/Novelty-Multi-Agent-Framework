        "providers": {
          "arxiv": {
            "enabled": true
          },
          "springer": {
            "enabled": false
          },
          "sciencedirect": {
            "enabled": false
          },
          "ieee_xplore": {
            "enabled": false
          }
        }
      }
    },
    "model": {
      "alias": "local-qwen2.5-7b"
    }
  },
  "reviewer": {
    "model": {
      "alias": "local-qwen2.5-7b"
    }
  },
  "search_planner": {
    "model": {
      "alias": "local-qwen2.5-7b"
    }
  },
  "coordinator": {
    "model": {
      "alias": "deepseek-official-flash",
      "enable_thinking": false,
      "max_tokens": 8192
    }
  },
  "point_extractor": {
    "model": {
      "alias": "local-qwen2.5-7b"
    }
  }
