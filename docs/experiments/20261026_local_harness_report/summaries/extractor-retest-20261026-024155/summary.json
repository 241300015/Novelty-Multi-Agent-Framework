        ]
      },
      {
        "point_id": "NP-2",
        "claim": "提出了一种基于图摘要技术的分布式图神经网络优化训练算法DSGNN，用于大规模图数据集上的图表示学习。",
        "claim_en": "",
        "technical_features": [
          "采用“领导——工作者”工作模式，领导节点使用基于边分割的图流划分算法对原图进行划分。",
          "工作节点基于图摘要技术进行小批量训练，并将结果通过注意力层返回给领导节点。",
          "在四个大规模图数据集上进行了实验验证，与集中式训练相比，DSGNN算法可以有效缩短训练时间和节约计算资源。"
        ],
        "technical_features_en": [],
        "source_locations": [
