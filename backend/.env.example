NOVELTY_HOST=0.0.0.0
NOVELTY_PORT=8010
NOVELTY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
NOVELTY_WORKFLOW_MODE=real
NOVELTY_RUNS_ROOT=outputs/web-runs
NOVELTY_MAX_UPLOAD_MB=30
# 默认本地；切换硅基流动、再切私人账户均须交互确认。
NOVELTY_EXPERIMENT_PROFILE=config/profiles/local-workflow.json
LOCAL_VLLM_API_KEY=local

NOVELTY_PROVIDER=openai_compatible
NOVELTY_MODEL=qwen2.5-7b-instruct
NOVELTY_BASE_URL=http://127.0.0.1:8000/v1
NOVELTY_API_KEY=
NOVELTY_TEMPERATURE=0.2
NOVELTY_TIMEOUT_SECONDS=60

# 硅基流动 API Key（settings.example.json 中 models 的 api_key_env 引用）
SILICONFLOW_API_KEY=
# 私人 DeepSeek 官方 API：选择 config/profiles/private-cloud-workflow.json
DEEPSEEK_API_KEY=

# Elsevier ScienceDirect（仅在启用 sciencedirect provider 时需要）
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# Springer Nature（Meta/Open Access 使用独立 Key；TDM metric 仅在 full_text_mode=tdm 时需要）
NOVELTY_SPRINGER_ENABLED=false
SPRINGER_NATURE_META_API_KEY=
SPRINGER_NATURE_OPEN_ACCESS_API_KEY=
SPRINGER_NATURE_TDM_API_METRIC=

# IEEE Xplore（Metadata/Open Access Full Text）
IEEE_XPLORE_API_KEY=

# 可选：按角色覆盖模型别名（覆盖 settings.example.json 中 agents.<角色>.model）
NOVELTY_COORDINATOR_MODEL=
NOVELTY_RESEARCH_MODEL=
